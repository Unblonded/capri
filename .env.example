# Port the app runs on
PORT=3000

# Option A (simplest): paste your personal API token.
# Find it in Todoist → Settings → Integrations → Developer → API token.
# You can also leave this blank and paste the token into the app's connect screen.
TODOIST_TOKEN=

# Option B: "Sign in with Todoist" via OAuth.
# Create an app at https://developer.todoist.com/appconsole.html
# and set its OAuth redirect URL to http://localhost:3000/auth/callback
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
