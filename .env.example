# Port the server listens on
PORT=3300

# Who can reach the server. 0.0.0.0 = other computers on your network too; 127.0.0.1 = this machine only.
# If you only use Capri through your domain and its tunnel/proxy runs on this computer, use 127.0.0.1.
HOST=0.0.0.0

# There are no Capri passwords or accounts: everyone signs in with their own Todoist API token
# (Todoist → Settings → Integrations → Developer). Each device gets a session cookie; the token stays on
# the server, encrypted, and Capri's own data (notes, schedule) is stored under data/users/<hash of token>/.

# Optional: the key that encrypts saved tokens. Unset, one is made on first run in data/secret.key.
# Changing or losing it signs everyone out.
# CAPRI_SECRET=

# Optional: "Sign in with Todoist" via OAuth instead of pasting a token.
# Create an app at https://developer.todoist.com/appconsole.html and set its OAuth redirect URL to
# https://capri.kalculator.lol/auth/callback (or http://localhost:3300/auth/callback when running locally).
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Behind a reverse proxy that isn't on this machine or your private network, set its address so
# https and client IPs are detected correctly.
# TRUST_PROXY=

# Android app: the SHA-256 fingerprint of its signing key (the Android build prints it), so Chrome runs
# Capri full screen without an address bar. Several keys: comma-separated.
# ANDROID_CERT_SHA256=
