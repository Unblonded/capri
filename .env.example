# Port the server listens on
PORT=3000

# Who can reach the server. 0.0.0.0 = other computers / your domain's reverse proxy; 127.0.0.1 = this machine only.
HOST=0.0.0.0

# REQUIRED if the server is reachable from other computers or the internet (e.g. https://capri.kalculator.lol).
# Anyone who can open Capri can use your Todoist, so pick something long.
CAPRI_PASSWORD=

# Option A (simplest): paste your personal API token.
# Find it in Todoist → Settings → Integrations → Developer → API token.
# You can also leave this blank and paste the token into Capri's connect screen.
TODOIST_TOKEN=

# Option B: "Sign in with Todoist" via OAuth.
# Create an app at https://developer.todoist.com/appconsole.html and set its OAuth redirect URL to
# https://capri.kalculator.lol/auth/callback (or http://localhost:3000/auth/callback when running locally).
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
