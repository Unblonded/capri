{
  "name": "capri",
  "version": "0.5.1",
  "description": "Capri — a liquid-glass Todoist client running on Express",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "icons": "electron desktop/make-icons.cjs",
    "predist:win": "node scripts/fetch-win-natives.mjs",
    "dist:win": "electron-builder --win nsis portable --x64",
    "update": "node scripts/update.mjs",
    "serve": "node --watch server.js",
    "serve:auto": "node scripts/autoserve.mjs",
    "build:desktop": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.unblonded.capri",
    "productName": "Capri",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "!desktop/make-icons.cjs",
      "package.json"
    ],
    "win": {
      "icon": "desktop/icons/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Capri-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "desktop/icons/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Capri-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://capri.kalculator.lol/updates"
      }
    ],
    "npmRebuild": false,
    "dmg": {
      "artifactName": "Capri-${version}-mac-${arch}.${ext}"
    },
    "afterSign": "scripts/adhoc-sign.cjs"
  },
  "author": "Unblonded"
}
